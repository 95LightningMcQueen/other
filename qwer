1.
Rename-Computer -NewName "SRV-DC01" -Restart

Install-WindowsFeature AD-Domain-Services -IncludeManagementTools

Install-ADDSForest -DomainName "lab.local" -DomainNetbiosName "LAB" -InstallDns

2.
$pwd = ConvertTo-SecureString "Student#2026" -AsPlainText -Force
New-ADUser -Name "student2" -SamAccountName "student2" `
 -UserPrincipalName "student2@lab.local" `
 -Path "OU=Students,DC=lab,DC=local" `
 -AccountPassword $pwd -Enabled $true -PasswordNeverExpires $true

New-ADGroup -Name "G_Staff" -GroupScope Global -GroupCategory Security `
 -Path "OU=Staff,DC=lab,DC=local"
Add-ADGroupMember -Identity "G_Staff" -Members "teacher1"

Add-ADGroupMember -Identity "G_Students" -Members "student1", "student2"

Get-ADUser -Filter * -SearchBase "OU=Students,DC=lab,DC=local" | Select-Object Name, Enabled
Get-ADGroupMember G_Students | Select-Object Name
Get-ADGroupMember G_Staff | Select-Object Name

3.
New-Item -ItemType Directory C:\Share\Lab -Force
New-Item -ItemType File C:\Share\Lab\readme.txt -Value "Лабораторная работа" -Force

Set-ADUser -Identity student1 -HomeDrive "Z:" -HomeDirectory "\\SRV-DC01\Lab"

New-SmbShare -Name Lab -Path C:\Share\Lab -ChangeAccess "Прошедшие проверку"
Get-SmbShare Lab
Get-Acl C:\Share\Lab | Format-List

4.
gpupdate /force

gpresult /user LAB\student1 /r
Get-GPO -All | Select-Object DisplayName, GpoStatus
Get-GPInheritance -Target "OU=Students,DC=lab,DC=local"

5.
net use \\SRV-DC01\Lab /user:LAB\student1 WrongPassword123

Get-WinEvent -FilterHashtable @{LogName='Security'; Id=4624,4625} -MaxEvents 10 | Select-Object TimeCreated, Id, Message | Format-List

Get-Process | Sort-Object WorkingSet -Descending | Select-Object -First 5 Name, Id, WorkingSet
