//шифт через три реверса
void ShiftCherezTri(int* arr, int size, int k)
{
	ReverseArray(arr, size);
	ReverseArray(arr, k);
	ReverseArray(arr + k, size - k);
}
//сортировки
void BubbleSort(int* arr, int size)
{
	for (int i = 0; i < size - 1; ++i)
	{
		for (int j = 0; j < size - i - 1; ++j)
		{
			if (arr[j] > arr[j + 1])
			{
				std::swap(arr[j], arr[j+1]);
			}
		}
	}
}

void ViboromSort(int* arr, int size)
{
	for (int i = 0; i < size - 1; ++i)
	{
		int IndeksOfMinElement = i;
		for (int j = i + 1; j < size; ++j)
		{
			if (arr[IndeksOfMinElement] > arr[j])
			{
				IndeksOfMinElement = j;
			}
			std::swap(arr[i], arr[IndeksOfMinElement]);
		}
	}
}

void VstavkaSort(int* arr, int size)
{
	for (int i = 1; i < size; ++i)
	{
		int key = arr[i];
		int j = i - 1;
		while (j >= 0 && arr[j] > key)
		{
			arr[j + 1] = arr[j];
			--j;
		}
		arr[j + 1] = key;
	}
}
//класс эрей
class Array {
private:
    int* array;
    int size;
public:
    Array() : array(nullptr), size(0) {}

    explicit Array(int n) : size(n) {
        array = new int[size]();
    }

    Array(int n, int value) : size(n) {
        array = new int[size];
        setAllMassive(value);
    }

    Array(const Array& other) : size(other.size) {
        array = new int[size];
        for (int i = 0; i < size; ++i)
            array[i] = other.array[i];
    }

    Array(Array&& other) noexcept : array(other.array), size(other.size) {
        other.array = nullptr;
        other.size = 0;
    }

    ~Array() {
        delete[] array;
    }

    Array& operator=(const Array& other) {
        if (this != &other) {
            delete[] array;
            size = other.size;
            array = new int[size];
            for (int i = 0; i < size; ++i)
                array[i] = other.array[i];
        }
        return *this;
    }

    Array& operator=(Array&& other) noexcept {
        if (this != &other) {
            delete[] array;
            array = other.array;
            size = other.size;
            other.array = nullptr;
            other.size = 0;
        }
        return *this;
    }

    int* getData() { return array; }
    int getSize() const { return size; }
    void setAllMassive(int value) {
        for (int i = 0; i < size; ++i)
            array[i] = value;
    }

    friend std::ostream& operator<<(std::ostream& os, const Array& arr) {
        os << "[";
        for (int i = 0; i < arr.size; ++i) {
            os << arr.array[i];
            if (i < arr.size - 1) os << ", ";
        }
        os << "]";
        return os;
    }
    // Оператор доступа
    int& operator[](int index) {
        return array[index];
    }

    void printElement(int index) const {
        std::cout << "Element[" << index << "] = " << array[index] << std::endl;
    }

    void printMassive() const {
        std::cout << "[";
        for (size_t i = 0; i < size; ++i) {
            std::cout << array[i];
            if (i < size - 1) std::cout << ", ";
        }
        std::cout << "]" << std::endl;
    }
};
