names = []
marks = []
with open('отметки.csv', 'r', encoding="Utf8") as F:
    for line in F:
        arr = line.strip().split(' ')
        names.append(arr[0])
        marks.append(float(arr[1]))  
        print(arr)

avg = sum(marks) / len(marks)
max_val = max(marks)
min_val = min(marks)

best_students = []
worst_students = []
for i in range(len(marks)):
    if marks[i] == max_val:
        best_students.append(names[i])
    if marks[i] == min_val:
        worst_students.append(names[i])

print('Average:', avg)
print(f'Max: {max_val}. student(s): {best_students}')
print(f'Min: {min_val}. student(s): {worst_students}')


