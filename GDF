    F.write('Of course, I am ready to help! To write a "human-like text" based on your request, I need to understand exactly what you want to get. Please clarify what you mean by "text" and what kind of text you need. Here are a few options of what you might mean and how I can help you: Do you want me to write a text on a specific topic? If yes, what should this text be about? (For example: travel, technology, personal experiences, science, a fictional story, etc.) What style do you prefer? (For example: formal, informal, conversational, poetic, scientific, artistic, humorous, etc.) Who is this text intended for? (For example: the general public, specialists, children, friends, etc.) What length of text do you need? (For example: a short message, a paragraph, an article, a story, etc.) Do you want me to rewrite an existing text to make it more "human-like" or understandable? If yes, please provide me with this text. Explain exactly what in it')

textik = []
with open('текст.csv', 'r', encoding="Utf8") as f:
    for line in f:
        arr = line.strip().split(' ')
        for word in arr:
            textik.append(word)
print(textik)

word_counts = {}
for word in textik:
    clean_word = word.strip('.,!?:;()')
    if clean_word == '': 
        continue
    if clean_word in word_counts:
        word_counts[clean_word] += 1
    else:
        word_counts[clean_word] = 1

sorted_keys = sorted(word_counts, key=word_counts.get, reverse=True)

for word, count in word_counts.items():
    print(f'{word}: {count}')
    

